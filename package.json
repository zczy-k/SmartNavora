{
  "name": "smartnavora-backend",
  "version": "1.43.1",
  "author": "zczy-k",
  "description": "SmartNavora backend - AI 智能导航网站后端",
  "repository": "https://github.com/zczy-k/SmartNavora",
  "license": "MIT",
  "main": "app.js",
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "follow-redirects": "^1.16.3",
    "minimatch": "^11.0.9",
    "qs": "^6.16.1",
    "nanoid": "^3.3.18",
    "tar": "^7.5.21",
    "fast-xml-parser": "^5.12.1",
    "ip-address": "^10.7.6",
    "postcss": "^8.5.33",
    "body-parser": "^2.4.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run web:dev\"",
    "server": "node app.js",
    "start": "node app.js",
    "start:https": "node start-with-https.js",
    "build": "npm run build --prefix web",
    "web:dev": "npm run dev --prefix web",
    "install:all": "npm install && npm install --prefix web",
    "check-password": "node scripts/check-password.js",
    "sync:version": "node scripts/sync-version.js",
    "release:patch": "npm version patch --no-git-tag-version && npm run sync:version && npm install --package-lock-only && npm install --prefix web --package-lock-only"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-schedule": "^2.1.1",
    "sanitize-html": "^2.18.2",
    "sqlite3": "^5.1.7",
    "undici": "^7.30.2",
    "unzipper": "^0.12.3",
    "webdav": "^5.11.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=6"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
